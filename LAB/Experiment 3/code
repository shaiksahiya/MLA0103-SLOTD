
import heapq

# Graph with transportation costs
graph = {
    'A': [('B', 2), ('C', 4)],
    'B': [('D', 7), ('E', 3)],
    'C': [('D', 1), ('F', 5)],
    'D': [('G', 2)],
    'E': [('G', 6)],
    'F': [('G', 3)],
    'G': []
}

def ucs(start, goal):
    priority_queue = [(0, start, [start])]
    visited = set()

    while priority_queue:
        cost, node, path = heapq.heappop(priority_queue)

        if node == goal:
            return path, cost

        if node not in visited:
            visited.add(node)

            for neighbor, weight in graph[node]:
                if neighbor not in visited:
                    heapq.heappush(
                        priority_queue,
                        (cost + weight, neighbor, path + [neighbor])
                    )

    return None, float('inf')


# Find least-cost path
path, cost = ucs('A', 'G')

print("Least Cost Path:", path)
print("Minimum Transportation Cost:", cost)
